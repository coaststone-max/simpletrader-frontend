{
  "rewrites": [
    {"source": "/", "destination": "/simpletrader.html"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Content-Security-Policy", "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:; connect-src *;"},
        {"key": "X-Frame-Options", "value": "DENY"}
      ]
    },
    {
      "source": "/api/webhook/(.*)",
      "headers": [
        {"key": "Access-Control-Allow-Origin", "value": "*"},
        {"key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS"}
      ]
    }
  ],
  "functions": {
    "api/webhook/tv.js":    {"maxDuration": 30},
    "api/tradovate/exec.js": {"maxDuration": 15}
  }
}
